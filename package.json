{
  "name": "poeruum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-seo-assets.mjs",
    "build:app": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run",
    "check:edge": "deno check --node-modules-dir=auto --frozen --minimum-dependency-age=0 supabase/functions/*/index.ts",
    "check": "npm run lint && npm run check:edge && npm run test && npm run build:app && npm audit --omit=dev --audit-level=high",
    "seo:generate": "node scripts/generate-seo-assets.mjs",
    "preview": "vite preview",
    "start": "node server.mjs",
    "test:stripe-billing": "node scripts/stripe-billing-e2e.mjs",
    "test:stripe-settlement": "node scripts/test-stripe-store-settlement.mjs",
    "test:reservation-cap": "node scripts/test-reservation-cap.mjs",
    "test:account-deletion": "node scripts/test-account-deletion.mjs",
    "supabase:check": "node scripts/supabase-admin.mjs check",
    "supabase:link": "node scripts/supabase-admin.mjs link",
    "supabase:deploy": "node scripts/supabase-admin.mjs deploy",
    "supabase:functions:deploy": "node scripts/supabase-admin.mjs functions",
    "supabase:auth-email": "node scripts/configure-auth-email.mjs",
    "supabase:auth-security": "node scripts/configure-auth-security.mjs",
    "security:headers:apply": "node scripts/configure-render-security.mjs apply",
    "security:headers:verify": "node scripts/configure-render-security.mjs verify",
    "deploy:gate:apply": "node scripts/configure-render-deploy-gate.mjs apply",
    "deploy:gate:verify": "node scripts/configure-render-deploy-gate.mjs verify",
    "supabase:auth-email:preview": "node scripts/send-auth-email-previews.mjs",
    "supabase:order-email:preview": "node scripts/send-order-email-preview.mjs",
    "supabase:onboarding-email:preview": "node scripts/send-onboarding-email-previews.mjs",
    "supabase:support:configure": "node scripts/configure-resend-support.mjs",
    "supabase:support:test-webhook": "node scripts/test-resend-webhook.mjs",
    "supabase:support:test-webhook:staging": "node scripts/test-resend-webhook-staging.mjs",
    "supabase:support:test-actions": "node scripts/test-support-actions.mjs",
    "supabase:set-admin": "node scripts/set-admin.mjs"
  },
  "dependencies": {
    "@stripe/connect-js": "^3.4.6",
    "@stripe/react-connect-js": "^3.4.4",
    "@supabase/supabase-js": "^2.109.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/ws": "^8.18.1",
    "deno": "2.9.4",
    "dotenv": "^17.4.2",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.4.0",
    "playwright": "^1.61.1",
    "postcss": "8.5.23",
    "supabase": "^2.109.1",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "ws": "^8.21.1"
  }
}
